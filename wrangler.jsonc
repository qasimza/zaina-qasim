{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zaina-qasim",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "routes": [
    { "pattern": "zainaqasim.com", "custom_domain": true },
    { "pattern": "www.zainaqasim.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // API routes always reach the Worker, even if a static file ever shadows the path
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
